{
  "name": "jcigreencity",
  "version": "2.0.0",
  "engines": {
    "node": "14"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "5.15.2",
    "axios": "^0.21.1",
    "bootstrap": "4.6.0",
    "chartist": "0.10.1",
    "font-awesome": "^4.7.0",
    "gulp": "4.0.2",
    "gulp-append-prepend": "1.0.8",
    "moment": "^2.29.1",
    "react": "17.0.1",
    "react-bootstrap": "1.4.3",
    "react-chartist": "0.14.3",
    "react-dom": "17.0.1",
    "react-notification-alert": "0.0.13",
    "react-router": "5.2.0",
    "react-router-dom": "5.2.0",
    "react-scripts": "4.0.1",
    "react-table": "^6.11.5",
    "react-toastify": "^8.0.3",
    "sass": "^1.69.5"
  },
  "optionalDependencies": {
    "jquery": "3.5.1",
    "reactstrap": "8.9.0",
    "typescript": "4.1.3"
  },
  "scripts": {
    "start": "set NODE_OPTIONS=--openssl-legacy-provider&& node --openssl-legacy-provider node_modules/react-scripts/bin/react-scripts.js start",
    "build": "set NODE_OPTIONS=--openssl-legacy-provider&& node --openssl-legacy-provider node_modules/react-scripts/bin/react-scripts.js build && gulp licenses",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install && npm start",
    "compile:scss": "sass src/assets/scss/light-bootstrap-dashboard-react.scss src/assets/css/light-bootstrap-dashboard-react.css",
    "minify:scss": "sass src/assets/scss/light-bootstrap-dashboard-react.scss src/assets/css/light-bootstrap-dashboard-react.min.css --style=compressed",
    "map:scss": "sass src/assets/scss/light-bootstrap-dashboard-react.scss src/assets/css/light-bootstrap-dashboard-react.css --source-map",
    "build:scss": "npm run compile:scss && npm run minify:scss && npm run map:scss"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
