# Backend API URL (phone on USB: http://127.0.0.1:3002 with adb reverse)
# Phone on WiFi: http://YOUR_PC_WIFI_IP:3002
URL=http://YOUR_PC_IP:3002

# Google Sign-In — must be a WEB OAuth client ID (Google Cloud Console → Credentials →
# Create OAuth client → Application type: Web application).
# Do NOT paste the Android client ID here (causes DEVELOPER_ERROR / code 10).
# Leave empty to use accessToken-only flow (works for local debug).
GOOGLE_WEB_CLIENT_ID=
